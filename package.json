{
  "name": "watchlister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:importmap && next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "types": "payload generate:types",
    "extract": "node scripts/extract-wordpress.mjs ../watchlisterco.sql ./data",
    "init-db": "tsx scripts/init-db.ts",
    "sync": "tsx scripts/sync-tmdb.ts",
    "upload-media": "node --env-file=.env.local scripts/upload-media-to-s3.mjs",
    "search-indexes": "node --env-file=.env.local scripts/create-search-indexes.mjs",
    "analytics-tables": "node --env-file=.env.local scripts/create-analytics-tables.mjs",
    "analytics-sample": "node --env-file=.env.local scripts/seed-analytics-sample.mjs",
    "check-digest": "tsx --env-file=.env.local scripts/check-digest.ts",
    "stats": "node --env-file=.env.local scripts/stats.mjs",
    "check-collect": "tsx --env-file=.env.local scripts/check-collect.ts",
    "check-proxy": "tsx scripts/check-proxy.ts",
    "send-digest": "tsx --env-file=.env.local scripts/send-digest.ts",
    "check-genres": "tsx --env-file=.env.local scripts/check-genres.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.1",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/email-resend": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "next": "16.3.0",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
