# Copy to .env.local and fill in. Never commit the filled-in version.

# Neon connection string, from the project dashboard.
# Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host.neon.tech/watchlister?sslmode=require

# Any long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# The Movie Database, v3 API key: https://www.themoviedb.org/settings/api
# The old site hardcoded this in plugin source, so the previous key should be
# rotated rather than reused.
TMDB_API_KEY=

# Public site URL, used for canonical links and sitemaps.
NEXT_PUBLIC_SITE_URL=https://watchlister.co

# Analytics. Set at most one; leaving both blank loads no script and sets no
# cookies, which is the right default for development.
#   GA4 measurement id, from analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=
#   Or a Tag Manager container. The old site used GTM-TJZDDM6X; reuse it only
#   if that container still exists and has tags worth keeping.
NEXT_PUBLIC_GTM_ID=

# Object storage for uploaded media. Leave blank in development to use local
# disk. REQUIRED in production on any serverless host — the filesystem there is
# read-only and ephemeral, so uploads would silently disappear.
# Works with S3, Cloudflare R2, Backblaze B2, or anything S3-compatible.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Daily digest email (Vercel Cron hits /cron/digest once a day).
# Without RESEND_API_KEY the endpoint returns the digest as JSON instead of
# sending, so it can be checked before any email account exists.
RESEND_API_KEY=
DIGEST_TO=lee@vermillionfilms.com
DIGEST_FROM=Watchlister <digest@watchlister.co>
# Vercel Cron sends this as a bearer token; without it the endpoint is open.
CRON_SECRET=
